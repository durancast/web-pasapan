---
import { site } from '../data/site';

interface Props {
	src?: string;
	title?: string;
	fullscreen?: boolean;
}
const { src = site.ordersUrl, title = 'Pedido online de Restaurante Pasapán', fullscreen = false } = Astro.props;
---
<div class="overflow-hidden rounded-3xl border border-line bg-cream shadow-lg shadow-ink/5">
	<iframe
		src={src}
		title={title}
		class:list={['w-full border-0', fullscreen ? 'h-[76svh] min-h-[580px] sm:h-[80svh]' : 'h-[78svh] min-h-[580px] sm:h-[1800px] lg:h-[1600px]']}
		loading={fullscreen ? 'eager' : 'lazy'}
		referrerpolicy="strict-origin-when-cross-origin"
		allow="payment"
	></iframe>
</div>