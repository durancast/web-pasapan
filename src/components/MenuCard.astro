---
import { formatPrice } from '../data/site';
import AllergenBadges from './AllergenBadges.astro';
import type { AllergenKey } from '../data/allergens';

interface Props {
	dish: {
		id: string;
		category: string;
		section: string;
		price: number;
		image: string;
		allergens: string[];
		veg?: 'veggie' | 'vegano';
		badge?: Record<string, string>;
		note?: Record<string, string>;
		name: Record<string, string>;
		description: Record<string, string>;
	};
	langs: string[];
}
const { dish, langs } = Astro.props;
const note = dish.note;
const badge = dish.badge;
---

<article
	id={dish.id}
	data-category={dish.category}
	data-section={dish.section}
	class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-cream shadow-sm shadow-ink/5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ink/10 sm:flex-row"
>
	<div class="relative shrink-0 sm:w-64">
		<figure class="aspect-[4/3] w-full overflow-hidden bg-paper-deep sm:h-full sm:aspect-auto">
			<img
				src={dish.image}
				alt={dish.name.es}
				loading="lazy"
				decoding="async"
				width={720}
				height={540}
				class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
			/>
		</figure>
		{badge ? (
			<div class="absolute top-3 left-3 rounded-full bg-burdeos px-3 py-1 text-[0.62rem] font-semibold tracking-[0.12em] text-cream uppercase shadow-md">
				{langs.map((l) => (
					<span lang={l} data-lang={l} hidden={l !== 'es'} inert={l !== 'es' ? true : undefined}>{badge[l] ?? badge.es}</span>
				))}
			</div>
		) : null}
	</div>

	<div class="flex flex-1 flex-col justify-between gap-3 p-5">
		<div>
			{langs.map((l) => (
				<h3 lang={l} data-lang={l} hidden={l !== 'es'} inert={l !== 'es' ? true : undefined} class="font-display text-lg leading-snug font-medium text-ink md:text-xl">
					{dish.name[l]}
				</h3>
			))}
			{langs.map((l) => (
				<p lang={l} data-lang={l} hidden={l !== 'es'} inert={l !== 'es' ? true : undefined} class="mt-1 text-sm leading-relaxed text-ink-soft">
					{dish.description[l]}
				</p>
			))}
			{dish.veg ? (
				<p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-olive/15 px-3 py-0.5 text-[0.65rem] font-semibold tracking-widest text-olive uppercase">
					<span aria-hidden="true">✦</span>
					<span data-i18n={`vegTags.${dish.veg}`}>{dish.veg === 'veggie' ? 'Vegetariano' : 'Vegano'}</span>
				</p>
			) : null}
		</div>

		<div class="flex flex-wrap items-end justify-between gap-3">
			<div class="flex flex-col gap-2">
				<AllergenBadges keys={dish.allergens as AllergenKey[]} />
				{note
					? langs.map((l) => (
							<p lang={l} data-lang={l} hidden={l !== 'es'} inert={l !== 'es' ? true : undefined} class="max-w-xs text-xs italic text-bark">
								{note[l]}
							</p>
						))
					: null}
			</div>
			<p class="shrink-0 font-display text-xl font-semibold tracking-wide text-burdeos">{formatPrice(dish.price)}</p>
		</div>
	</div>
</article>