---
import PageHero from '../components/PageHero.astro';
import type { LegalDoc } from '../data/legal';

interface Props {
	doc: LegalDoc;
}
const { doc } = Astro.props;
---
<PageHero title={doc.title} eyebrow="Información legal" image="/img/hero/carta-header.jpg" />

<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
	{doc.intro ? <p class="rounded-xl border border-line bg-cream px-5 py-4 text-sm italic leading-relaxed text-ink-soft">{doc.intro}</p> : null}

	<div class="mt-10 space-y-10">
		{doc.sections.map((section) => (
			<section>
				<h2 class="font-display text-xl leading-snug font-medium text-ink">{section.heading}</h2>
				{section.paras ? (
					<div class="mt-3 space-y-3">
						{section.paras.map((p) => (
							<p class="text-sm leading-relaxed text-ink-soft">{p}</p>
						))}
					</div>
				) : null}
				{section.list ? (
					<ul class="mt-3 space-y-2">
						{section.list.map((item) => (
							<li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
								<span aria-hidden="true" class="mt-0.5 font-display text-burdeos">•</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				) : null}
			</section>
		))}
	</div>
</div>