---
import { Picture } from 'astro:assets';
import { getImage, HERO_WIDTHS, responsiveWidths } from '../data/images';

interface Props {
	title: string;
	eyebrow?: string;
	description?: string;
	image?: string;
	titleI18n?: string;
	eyebrowI18n?: string;
	descriptionI18n?: string;
}
const { title, eyebrow, description, image = '/img/hero/carta-header.jpg', titleI18n, eyebrowI18n, descriptionI18n } = Astro.props;
const heroAsset = getImage(image);
const heroWidths = heroAsset ? responsiveWidths(heroAsset.width, HERO_WIDTHS) : [];
---
<section class="relative overflow-hidden bg-ink text-paper">
	{heroAsset ? (
		<Picture
			src={heroAsset.image}
			formats={['avif', 'webp']}
			fallbackFormat="webp"
			widths={heroWidths}
			sizes="100vw"
			quality={70}
			alt=""
			loading="eager"
			fetchpriority="high"
			decoding="async"
			class="h-full w-full object-cover opacity-40"
			pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
		/>
	) : (
		<img src={image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" loading="eager" fetchpriority="high" decoding="async" />
	)}
	<div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30" aria-hidden="true"></div>
	<div class="relative mx-auto max-w-5xl px-4 py-20 text-center sm:px-6 sm:py-28">
		{eyebrow ? <p data-i18n={eyebrowI18n} class="text-xs font-semibold tracking-[0.3em] text-gold-light uppercase drop-shadow-sm">{eyebrow}</p> : null}
		<h1 data-i18n={titleI18n} class="mt-4 font-display text-4xl leading-tight font-medium sm:text-6xl">{title}</h1>
		{description ? <p data-i18n={descriptionI18n} class="mx-auto mt-5 max-w-2xl leading-relaxed text-paper/80">{description}</p> : null}
		<div class="rule-gold mx-auto mt-8 w-28"></div>
		<p data-i18n="hero.place" class="mt-8 text-xs tracking-[0.2em] text-paper/60 uppercase">Restaurante Pasapán · Segovia</p>
	</div>
</section>
