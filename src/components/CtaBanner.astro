---
import { site } from '../data/site';
import { allergenCatalog } from '../data/allergens';

interface Props {
	showAllergens?: boolean;
}
const { showAllergens = false } = Astro.props;
---
<section class="border-t border-line bg-paper-deep/50">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
			<div class="max-w-2xl">
				<p data-i18n="cta.eyebrow" class="text-xs font-semibold tracking-[0.28em] text-gold-deep uppercase">Pasa un buen día entre nosotros</p>
				<h2 data-i18n="cta.title" class="mt-3 font-display text-3xl leading-tight font-medium text-ink sm:text-4xl">Reserva tu mesa o contáctanos</h2>
				<p data-i18n="cta.note" class="mt-3 leading-relaxed text-ink-soft">Reserva online con confirmación inmediata. Si sois un grupo de más de 8 personas o tenéis alguna petición especial, escríbenos o llámanos con antelación y nos encargaremos de todo.</p>
			</div>
			<div class="flex shrink-0 flex-wrap gap-3">
				<a href={site.reservationsUrl} target="_blank" rel="noopener noreferrer" data-i18n="reservas" class="rounded-full bg-burdeos px-6 py-3 text-xs font-semibold tracking-widest text-cream uppercase shadow-md shadow-burdeos/20 transition-all hover:-translate-y-0.5 hover:bg-burdeos-deep">
					Reservar mesa
				</a>
				<a href={site.ordersUrl} target="_blank" rel="noopener noreferrer" data-i18n="pedidos" class="rounded-full border border-burdeos/40 px-6 py-3 text-xs font-semibold tracking-widest text-burdeos uppercase transition-colors hover:bg-burdeos hover:text-cream">
					Pedir online
				</a>
				<a href="/contacto/" data-i18n="footerContactanos" class="rounded-full border border-ink/20 px-6 py-3 text-xs font-semibold tracking-widest text-ink uppercase transition-colors hover:bg-ink hover:text-paper">
					Contáctanos
				</a>
			</div>
		</div>

		<div class="mt-14 grid gap-10 md:grid-cols-3">
			<div class="md:col-span-2">
				<div class="grid gap-8 sm:grid-cols-2">
					<div class="rounded-2xl border border-line bg-cream p-6">
						<h3 data-i18n="cta.products" class="font-display text-xl font-medium text-ink">Nuestros Productos</h3>
						<p data-i18n="cta.productsText" class="mt-3 text-sm leading-relaxed text-ink-soft">Platos elaborados con toda nuestra experiencia. Nos esforzamos en conseguir sensaciones deliciosas y agradables.</p>
					</div>
					<div class="rounded-2xl border border-line bg-cream p-6">
						<h3 data-i18n="cta.philosophy" class="font-display text-xl font-medium text-ink">Nuestra Filosofía</h3>
						<p data-i18n="cta.philosophyText" class="mt-3 text-sm leading-relaxed text-ink-soft">Tomamos muchas decisiones sobre lo que comemos y cada una de nuestras elecciones de alimentos tiene un impacto ético y ambiental.</p>
					</div>
				</div>

				{showAllergens ? (
					<div class="mt-8 rounded-2xl border border-line bg-cream p-6">
						<h3 data-i18n="cta.allergens" class="font-display text-xl font-medium text-ink">Leyenda de alérgenos</h3>
						<ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2 text-xs text-ink-soft sm:grid-cols-3">
							{allergenCatalog.map((a) => (
								<li class="flex items-center gap-2">
									<img src={a.icon} alt="" width={18} height={18} class="h-[18px] w-[18px] rounded" loading="lazy" />
									{a.label}
								</li>
							))}
						</ul>
					</div>
				) : null}
			</div>

			<div class="flex flex-col gap-6">
				<img src="/img/restaurant/rincon.jpg" alt="Rincón del restaurante con mesa junto a la ventana" loading="lazy" decoding="async" width={640} height={480} class="h-72 w-full rounded-2xl border border-line object-cover" />
			</div>
		</div>
	</div>
</section>
