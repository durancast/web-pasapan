---
interface Props {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
	className?: string;
}
const { eyebrow, title, subtitle, align = 'left', className = '' } = Astro.props;
---
<div class:list={[align === 'center' && 'text-center', className]}>
	{eyebrow ? <p class="text-xs font-semibold tracking-[0.28em] text-gold-deep uppercase">{eyebrow}</p> : null}
	<h2 class="mt-3 font-display text-3xl leading-tight font-medium text-ink sm:text-4xl">{title}</h2>
	{subtitle ? <p class={['mt-4 max-w-2xl leading-relaxed text-ink-soft', align === 'center' && 'mx-auto'].join(' ')}>{subtitle}</p> : null}
	<div class:list={['rule-gold mt-6 w-24', align === 'center' && 'mx-auto']}></div>
</div>