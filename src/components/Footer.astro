---
import { site } from '../data/site';
import { NAV_I18N, type Lang } from '../data/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const i18n = NAV_I18N[lang];

const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-line bg-paper-deep/60 pb-20 sm:pb-0">
	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
			<div>
				<img src="/img/logo/logo-text.png" alt="Restaurante Pasapán — Segovia" width={180} height={40} class="h-10 w-auto" loading="lazy" />
				<p class="mt-4 text-sm leading-relaxed text-ink-soft">
					<span data-i18n="footerContactanos">{i18n.footerContactanos}</span>
				</p>
				<p class="mt-4 text-sm font-medium">
					<a href={`tel:${site.phone.tel}`} class="block text-ink hover:text-burdeos">{site.phone.display}</a>
					<a href={`mailto:${site.email}`} class="mt-1 block text-ink hover:text-burdeos">{site.email}</a>
				</p>
			</div>

			<div>
				<h2 data-i18n="footerDireccion" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">{i18n.footerDireccion}</h2>
				<address class="mt-4 text-sm leading-relaxed text-ink-soft not-italic">
					{site.name}<br />
					{site.address.street}<br />
					{site.address.postalCode} {site.address.city}<br />
					{site.address.country}
				</address>
				<a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer" data-i18n="footerComoLlegar" class="mt-4 inline-block text-sm font-medium text-burdeos underline-offset-4 hover:underline">{i18n.footerComoLlegar}</a>
			</div>

			<div>
				<h2 data-i18n="footerOpciones" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">{i18n.footerOpciones}</h2>
				<ul class="mt-4 space-y-2 text-sm text-ink-soft">
					{site.legal.map((link) => (
						<li>
							<a href={link.url} class="transition-colors hover:text-burdeos">{link.label}</a>
						</li>
					))}
				</ul>
			</div>

			<div class="flex flex-col justify-between gap-6">
				<div>
					<h2 data-i18n="footerHorario" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">{i18n.footerHorario}</h2>
					<ul class="mt-4 space-y-2 text-sm text-ink-soft">
						<li>
							<p data-i18n="days">{i18n.days}</p>
							{site.hours.map((h, i) => (
								<p class={i === 0 ? 'mt-1' : ''}>{h.label}</p>
							))}
						</li>
					</ul>
					<p class="mt-4 flex items-center gap-1 text-xs tracking-wide text-olive uppercase">
						<i aria-hidden="true" class="h-px w-6 bg-olive"></i>
						<span data-i18n="footerHechoSegovia">{i18n.footerHechoSegovia}</span>
					</p>
				</div>
				<div class="flex items-center justify-between gap-4">
					<div>
						<h2 data-i18n="footerSiguenos" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">{i18n.footerSiguenos}</h2>
						<ul class="mt-3 flex flex-wrap items-center gap-3 text-sm font-medium text-ink-soft">
							{site.socials.map((s) => (
								<li>
									<a
										href={s.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-3 py-1.5 transition-colors hover:border-burdeos hover:text-burdeos"
									>
										{s.label === 'Instagram' ? (
											<svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
												<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
												<circle cx="12" cy="12" r="4.2"></circle>
												<circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none"></circle>
											</svg>
										) : s.label === 'Facebook' ? (
											<svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
												<path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5H16.5V4.9c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.3v7h3.2z"></path>
											</svg>
										) : s.label === 'Tripadvisor' ? (
											<svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
												<path d="M12 10.2c1.4-2.1 3.8-3.5 6.5-3.5 2.9 0 5.3 2.3 5.3 5.2S21.4 17 18.5 17c-1.9 0-3.6-.9-4.7-2.3M12 10.2C10.6 8.1 8.2 6.7 5.5 6.7c-2.9 0-5.3 2.3-5.3 5.2S2.6 17 5.5 17c1.9 0 3.6-.9 4.7-2.3M12 10.2v4.5m-6.3-4.7a2.1 2.1 0 1 0 4.2 0 2.1 2.1 0 0 0-4.2 0zm8.4 0a2.1 2.1 0 1 0 4.2 0 2.1 2.1 0 0 0-4.2 0z"></path>
											</svg>
										) : null}
										{s.label}
									</a>
								</li>
							))}
						</ul>
					</div>
					<a href="/carta/" class="shrink-0" aria-label={i18n.footerQr} data-i18n-aria="footerQr" title={i18n.footerQr}>
						<img src="/img/logo/qr-carta.png" alt={i18n.footerQr} class="h-16 w-16 rounded-md border border-line" loading="lazy" width={64} height={64} />
					</a>
				</div>
			</div>
		</div>

		<div class="mt-12 border-t border-line pt-6 text-center text-xs text-bark">
			<p>
				© {year} {site.name} ({site.address.city}) · <a href="/aviso-legal/" class="hover:text-burdeos">Aviso legal</a> · <a href="/privacidad/" class="hover:text-burdeos">Privacidad</a> · <a href="/cookies/" class="hover:text-burdeos">Cookies</a>
			</p>
		</div>
	</div>
</footer>