---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LegendStory from '../components/LegendStory.astro';
import MenuCard from '../components/MenuCard.astro';
import DrinkSection from '../components/DrinkSection.astro';
import { allergenCatalog } from '../data/allergens';
import { beers, juices, wines } from '../data/drinks';
import menu from '../data/menu.json';

interface MenuDish {
	id: string;
	category: string;
	section: string;
	price: number;
	image: string;
	allergens: string[];
	veg?: 'veggie' | 'vegano';
	badge?: Record<string, string>;
	note?: Record<string, string>;
	name: Record<string, string>;
	description: Record<string, string>;
}

const langs: string[] = menu.langs;
const sections = ['entrantes', 'principales', 'postres'];
const categories = ['general', 'veggie', 'sin-gluten'];

const drinkTabs = [
	{ id: 'vinos', labelKey: 'filters.vinos' },
	{ id: 'bebidas', labelKey: 'filters.bebidas' },
];

const drinkPanels = [
	{ id: 'vinos', categories: wines },
	{ id: 'bebidas', categories: [...beers, ...juices] },
];

const ui: Record<string, Record<string, string>> = {};
for (const lang of langs) {
	const u = menu.ui[lang as keyof typeof menu.ui];
	ui[lang] = {
		menuTitle: u.menuTitle,
		'filters.general': u.filters.general,
		'filters.veggie': u.filters.veggie,
		'filters.sin-gluten': u.filters['sin-gluten'],
		'filters.vinos': u.filters.vinos,
		'filters.bebidas': u.filters.bebidas,
		'sections.entrantes': u.sections.entrantes,
		'sections.principales': u.sections.principales,
		'sections.postres': u.sections.postres,
		categoriesLabel: u.categoriesLabel,
		allergenLegend: u.allergenLegend,
		'vegTags.veggie': u.vegTags.veggie,
		'vegTags.vegano': u.vegTags.vegano,
		badge: u.badge,
		glutenNote: u.glutenNote,
	};
}

const dishes = menu.dishes as unknown as MenuDish[];
---
<BaseLayout
	title="Carta Pasapán · Restaurante Pasapán · Segovia"
	description="Carta del Restaurante Pasapán en Segovia: carta general, veggie y sin gluten. Cocina tradicional del siglo XXI con producto local. Selecciona tu idioma y tu carta."
>
	<PageHero
		title="Carta Pasapán"
		titleI18n="page.carta.title"
		eyebrow="Cocina tradicional del siglo XXI"
		eyebrowI18n="page.carta.eyebrow"
		description="Platos elaborados con producto de la tierra de Segovia: de la parrilla al plato más creativo, en versión general, veggie o sin gluten."
		descriptionI18n="page.carta.desc"
		image="/img/hero/carta-header.jpg"
	/>

	<section id="carta-content" class="mx-auto max-w-6xl scroll-mt-40 px-4 sm:px-6">
		<!-- Barra de control: categorías -->
		<div class="sticky z-40 -mx-4 border-b border-line bg-paper/90 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6 sm:py-3" style="top: var(--header-offset, 88px)">
			<div role="group" aria-label="Elegir carta" data-i18n-aria="categoriesLabel" class="flex flex-nowrap items-center gap-2 overflow-x-auto no-scrollbar">
				{categories.map((c) => (
					<button
						type="button"
						data-tab-btn={c}
						aria-pressed="false"
						class="inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-paper px-3 py-1.5 text-[0.7rem] font-semibold tracking-widest text-ink-soft uppercase transition-all sm:px-4 sm:text-xs"
					>
						<span data-i18n={`filters.${c}`}>{ui.es[`filters.${c}`]}</span>
					</button>
				))}
				<span aria-hidden="true" class="mx-1 h-5 w-px shrink-0 self-center bg-sand"></span>
				{drinkTabs.map((tab) => (
					<button
						type="button"
						data-tab-btn={tab.id}
						aria-pressed="false"
						class="inline-flex shrink-0 items-center gap-2 rounded-full border border-gold/60 bg-cream px-3 py-1.5 text-[0.7rem] font-semibold tracking-widest whitespace-nowrap text-gold-deep uppercase transition-all hover:border-gold-deep sm:px-4 sm:text-xs"
					>
						{tab.id === 'vinos' ? (
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0">
								<path d="M8 3h8l-.7 5.2a3.4 3.4 0 0 1-6.6 0L8 3Z" />
								<path d="M12 13.4V20" />
								<path d="M8.5 20.5h7" />
							</svg>
						) : (
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0">
								<path d="M6 7h9v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z" />
								<path d="M15 10h2.5A1.5 1.5 0 0 1 19 11.5v4a1.5 1.5 0 0 1-1.5 1.5H15" />
								<path d="M6 7c0-1.7 1.3-2.5 3-2.5h3C13.7 4.5 15 5.3 15 7" />
							</svg>
						)}
						<span data-i18n={tab.labelKey}>{ui.es[tab.labelKey]}</span>
					</button>
				))}
			</div>
		</div>

		<!-- Secciones de platos -->
		{sections.map((section) => (
			<section id={section} data-section-block={section} class="mt-14 scroll-mt-44">
				<div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
					<h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">
						<span aria-hidden="true" class="mr-3 text-gold">✦</span>
						<span data-i18n={`sections.${section}`}>{ui.es[`sections.${section}`]}</span>
					</h2>
				</div>
				<LegendStory section={section as 'entrantes' | 'principales' | 'postres'} />
				<div class="mt-6 grid gap-5">
					{dishes
						.filter((d) => d.section === section)
						.map((dish) => (
							<MenuCard dish={dish} langs={langs} />
						))}
				</div>
			</section>
		))}

		<!-- Aviso sin gluten -->
		<p data-cat-note="sin-gluten" hidden inert class="mt-12 rounded-xl border border-dashed border-olive/50 bg-olive/10 px-5 py-4 text-sm leading-relaxed text-ink-soft italic" data-i18n="glutenNote">
			{ui.es.glutenNote}
		</p>

		<!-- Bodega y bebidas -->
		<section id="bebidas" class="mt-10 scroll-mt-44" hidden inert>
			{drinkPanels.map((panel) => (
				<div id={`panel-${panel.id}`} data-drink-panel={panel.id} hidden inert>
					<DrinkSection categories={panel.categories} />
				</div>
			))}
		</section>

		<!-- Leyenda de alérgenos -->
		<div id="allergen-legend" class="mt-14 rounded-3xl border border-line bg-cream p-6 sm:p-8">
			<h2 class="font-display text-xl font-medium text-ink">
				<span aria-hidden="true" class="mr-2 text-gold">✦</span>
				<span data-i18n="allergenLegend">{ui.es.allergenLegend}</span>
			</h2>
			<ul class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
				{allergenCatalog.map((a) => (
					<li class="flex items-center gap-2 text-sm text-ink-soft">
						<img src={a.icon} alt="" width={22} height={22} loading="lazy" decoding="async" class="h-[22px] w-[22px] rounded-[4px] border border-line/70" />
						<span data-i18n={`allergen.${a.key}`}>{a.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>

<script type="application/json" id="carta-i18n" set:html={JSON.stringify(ui)}>
</script>

<script>
	const DEFAULT_TAB = 'general';
	const foodCategories = ['general', 'veggie', 'sin-gluten'];
	const drinkTabIds = ['vinos', 'bebidas'];
	const allCategories = [...foodCategories, ...drinkTabIds];

	const DRINK_TAB_BY_CATEGORY: Record<string, string> = {
		tintos: 'vinos',
		blancos: 'vinos',
		rosados: 'vinos',
		espumosos: 'vinos',
		cervezas: 'bebidas',
		zumos: 'bebidas',
	};

	const isDrinkTab = (tab: string) => drinkTabIds.includes(tab);

	let activeTab = localStorage.getItem('pasapan.category') ?? DEFAULT_TAB;
	if (!allCategories.includes(activeTab)) activeTab = DEFAULT_TAB;

	const fromHash = location.hash.replace('#', '');
	let scrollTarget: HTMLElement | null = null;
	if (fromHash) {
		if (allCategories.includes(fromHash)) {
			activeTab = fromHash;
			history.replaceState(null, '', `${location.pathname}${location.search}`);
		} else {
			const target = document.getElementById(fromHash);
			if (target?.hasAttribute('data-category')) {
				const tab = target.getAttribute('data-category') ?? activeTab;
				activeTab = allCategories.includes(tab) ? tab : DEFAULT_TAB;
				scrollTarget = target;
			} else if (DRINK_TAB_BY_CATEGORY[fromHash]) {
				activeTab = DRINK_TAB_BY_CATEGORY[fromHash];
			}
		}
	}

	const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]'));
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
	const sectionBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-section-block]'));
	const catNotes = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-note]'));
	const drinksSection = document.getElementById('bebidas');
	const drinkPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-drink-panel]'));
	const allergenLegend = document.getElementById('allergen-legend');

	function setHidden(el: Element | null, hidden: boolean) {
		if (!el) return;
		(el as HTMLElement).hidden = hidden;
		el.toggleAttribute('inert', hidden);
	}

	function applyTab(next: string) {
		activeTab = next;
		localStorage.setItem('pasapan.category', next);
		const drinkMode = isDrinkTab(next);

		// Platos (comida)
		for (const card of cards) {
			const on = !drinkMode && card.getAttribute('data-category') === next;
			card.hidden = !on;
			card.toggleAttribute('inert', !on);
		}
		for (const block of sectionBlocks) {
			const visible = Array.from(block.querySelectorAll<HTMLElement>('[data-category]')).some((c) => !c.hidden);
			block.hidden = !visible;
			block.toggleAttribute('inert', !visible);
		}
		for (const note of catNotes) {
			const on = !drinkMode && note.getAttribute('data-cat-note') === next;
			note.hidden = !on;
			note.toggleAttribute('inert', !on);
		}
		setHidden(allergenLegend, drinkMode);

		// Bodega y bebidas
		setHidden(drinksSection, !drinkMode);
		for (const panel of drinkPanels) {
			const on = drinkMode && panel.getAttribute('data-drink-panel') === next;
			panel.hidden = !on;
			panel.toggleAttribute('inert', !on);
		}

		// Botones de la barra sticky
		for (const b of tabButtons) {
			const id = b.getAttribute('data-tab-btn') ?? '';
			const active = id === next;
			const drinkBtn = isDrinkTab(id);
			b.setAttribute('aria-pressed', String(active));
			if (drinkBtn) {
				b.classList.toggle('bg-ink', active);
				b.classList.toggle('text-cream', active);
				b.classList.toggle('border-ink', active);
				b.classList.toggle('shadow-sm', active);
				b.classList.toggle('border-gold/60', !active);
				b.classList.toggle('bg-cream', !active);
				b.classList.toggle('text-gold-deep', !active);
				b.classList.toggle('hover:border-gold-deep', !active);
			} else {
				b.classList.toggle('bg-burdeos', active);
				b.classList.toggle('text-cream', active);
				b.classList.toggle('border-burdeos', active);
				b.classList.toggle('border-line', !active);
				b.classList.toggle('text-ink-soft', !active);
				b.classList.toggle('bg-paper', !active);
			}
		}
	}

	function scrollToCartaTop() {
		const container = document.getElementById('carta-content');
		if (!container) return;
		if (container.getBoundingClientRect().top >= 0) return;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		container.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
	}

	for (const b of tabButtons) {
		b.addEventListener('click', () => {
			for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-section-block] details[open]')) d.open = false;
			applyTab(b.getAttribute('data-tab-btn')!);
			scrollToCartaTop();
		});
	}

	applyTab(activeTab);

	if (scrollTarget) {
		requestAnimationFrame(() => scrollTarget?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
	}
	if (fromHash && (drinkTabIds.includes(fromHash) || DRINK_TAB_BY_CATEGORY[fromHash])) {
		requestAnimationFrame(() => document.getElementById(fromHash)?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
	}
</script>
