---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LegendStory from '../components/LegendStory.astro';
import MenuCard from '../components/MenuCard.astro';
import DrinkSection from '../components/DrinkSection.astro';
import { allergenCatalog } from '../data/allergens';
import { beers, juices, wines } from '../data/drinks';
import menu from '../data/menu.json';

interface MenuDish {
	id: string;
	category: string;
	section: string;
	price: number;
	image: string;
	allergens: string[];
	veg?: 'veggie' | 'vegano';
	badge?: Record<string, string>;
	note?: Record<string, string>;
	name: Record<string, string>;
	description: Record<string, string>;
}

const langs: string[] = menu.langs;
const sections = ['entrantes', 'principales', 'postres'];
const categories = ['general', 'veggie', 'sin-gluten'];

const drinkTabs = [
	{ id: 'vinos', labelKey: 'filters.vinos' },
	{ id: 'bebidas', labelKey: 'filters.bebidas' },
];

const drinkPanels = [
	{ id: 'vinos', categories: wines },
	{ id: 'bebidas', categories: [...beers, ...juices] },
];

const ui: Record<string, Record<string, string>> = {};
for (const lang of langs) {
	const u = menu.ui[lang as keyof typeof menu.ui];
	ui[lang] = {
		menuTitle: u.menuTitle,
		'filters.general': u.filters.general,
		'filters.veggie': u.filters.veggie,
		'filters.sin-gluten': u.filters['sin-gluten'],
		'filters.vinos': u.filters.vinos,
		'filters.bebidas': u.filters.bebidas,
		'sections.entrantes': u.sections.entrantes,
		'sections.principales': u.sections.principales,
		'sections.postres': u.sections.postres,
		categoriesLabel: u.categoriesLabel,
		allergenLegend: u.allergenLegend,
		'vegTags.veggie': u.vegTags.veggie,
		'vegTags.vegano': u.vegTags.vegano,
		badge: u.badge,
		glutenNote: u.glutenNote,
	};
}

const dishes = menu.dishes as unknown as MenuDish[];
---
<BaseLayout
	title="Carta Pasapán · Restaurante Pasapán · Segovia"
	description="Carta del Restaurante Pasapán en Segovia: carta general, veggie y sin gluten. Cocina tradicional del siglo XXI con producto local. Selecciona tu idioma y tu carta."
>
	<PageHero
		title="Carta Pasapán"
		titleI18n="page.carta.title"
		eyebrow="Cocina tradicional del siglo XXI"
		eyebrowI18n="page.carta.eyebrow"
		description="Platos elaborados con producto de la tierra de Segovia: de la parrilla al plato más creativo, en versión general, veggie o sin gluten."
		descriptionI18n="page.carta.desc"
		image="/img/hero/carta-header.jpg"
	/>

	<section class="mx-auto max-w-6xl px-4 sm:px-6">
		<!-- Barra de control: categorías -->
		<div class="sticky z-40 -mx-4 border-b border-line bg-paper/90 px-4 py-2 backdrop-blur-md sm:-mx-6 sm:px-6 sm:py-3" style="top: var(--header-offset, 88px)">
			<div role="group" aria-label="Elegir carta" data-i18n-aria="categoriesLabel" class="flex flex-nowrap gap-2 overflow-x-auto no-scrollbar">
				{categories.map((c) => (
					<button
						type="button"
						data-category-btn={c}
						class="inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-paper px-3 py-1.5 text-[0.7rem] font-semibold tracking-widest text-ink-soft uppercase transition-all sm:px-4 sm:text-xs"
					>
						<span data-i18n={`filters.${c}`}>{ui.es[`filters.${c}`]}</span>
					</button>
				))}
				{drinkTabs.map((tab, i) => (
					<button
						type="button"
						role="tab"
						id={`tab-${tab.id}`}
						data-drink-tab={tab.id}
						aria-controls={`panel-${tab.id}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						class="inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-paper px-3 py-1.5 text-[0.7rem] font-semibold tracking-widest whitespace-nowrap text-ink-soft uppercase transition-all sm:px-4 sm:text-xs"
					>
						<span data-i18n={tab.labelKey}>{ui.es[tab.labelKey]}</span>
					</button>
				))}
			</div>
		</div>

		<!-- Secciones de platos -->
		{sections.map((section) => (
			<section id={section} data-section-block={section} class="mt-14 scroll-mt-44">
				<div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
					<h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">
						<span aria-hidden="true" class="mr-3 text-gold">✦</span>
						<span data-i18n={`sections.${section}`}>{ui.es[`sections.${section}`]}</span>
					</h2>
				</div>
				<LegendStory section={section as 'entrantes' | 'principales' | 'postres'} />
				<div class="mt-6 grid gap-5">
					{dishes
						.filter((d) => d.section === section)
						.map((dish) => (
							<MenuCard dish={dish} langs={langs} />
						))}
				</div>
			</section>
		))}

		<!-- Aviso sin gluten -->
		<p data-cat-note="sin-gluten" hidden class="mt-12 rounded-xl border border-dashed border-olive/50 bg-olive/10 px-5 py-4 text-sm leading-relaxed text-ink-soft italic" data-i18n="glutenNote">
			{ui.es.glutenNote}
		</p>

		<!-- Bodega y bebidas -->
		<section id="bebidas" class="mt-16 scroll-mt-44">
			{drinkPanels.map((panel, i) => (
				<div
					id={`panel-${panel.id}`}
					data-drink-panel={panel.id}
					role="tabpanel"
					aria-labelledby={`tab-${panel.id}`}
					hidden={i !== 0}
					inert={i !== 0 ? true : undefined}
					class="mt-10"
				>
					<DrinkSection categories={panel.categories} />
				</div>
			))}
		</section>

		<!-- Leyenda de alérgenos -->
		<div class="mt-14 rounded-3xl border border-line bg-cream p-6 sm:p-8">
			<h2 class="font-display text-xl font-medium text-ink">
				<span aria-hidden="true" class="mr-2 text-gold">✦</span>
				<span data-i18n="allergenLegend">{ui.es.allergenLegend}</span>
			</h2>
			<ul class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
				{allergenCatalog.map((a) => (
					<li class="flex items-center gap-2 text-sm text-ink-soft">
						<img src={a.icon} alt="" width={22} height={22} loading="lazy" decoding="async" class="h-[22px] w-[22px] rounded-[4px] border border-line/70" />
						{a.label}
					</li>
				))}
			</ul>
		</div>
	</section>
</BaseLayout>

<script type="application/json" id="carta-i18n" set:html={JSON.stringify(ui)}>
</script>

<script>
	const DEFAULT_CATEGORY = 'general';
	const categories = ['general', 'veggie', 'sin-gluten'];

	let category = localStorage.getItem('pasapan.category') ?? DEFAULT_CATEGORY;
	if (!categories.includes(category)) category = DEFAULT_CATEGORY;

	const fromHash = location.hash.replace('#', '');
	let scrollTarget: HTMLElement | null = null;
	if (fromHash) {
		if (categories.includes(fromHash)) {
			category = fromHash;
			history.replaceState(null, '', `${location.pathname}${location.search}`);
		} else {
			const target = document.getElementById(fromHash);
			if (target?.hasAttribute('data-category')) {
				category = target.getAttribute('data-category') ?? category;
				scrollTarget = target;
			}
		}
	}

	const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-btn]'));
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
	const sectionBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-section-block]'));
	const catNotes = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-note]'));

	function applyCategory(next: string) {
		category = next;
		localStorage.setItem('pasapan.category', next);
		for (const card of cards) {
			const on = card.getAttribute('data-category') === next;
			card.hidden = !on;
			card.toggleAttribute('inert', !on);
		}
		for (const block of sectionBlocks) {
			const visible = Array.from(block.querySelectorAll<HTMLElement>('[data-category]')).some((c) => !c.hidden);
			block.hidden = !visible;
			block.toggleAttribute('inert', !visible);
		}
		for (const note of catNotes) note.hidden = note.getAttribute('data-cat-note') !== next;
		for (const b of categoryButtons) {
			const active = b.getAttribute('data-category-btn') === next;
			b.setAttribute('aria-pressed', String(active));
			b.classList.toggle('bg-burdeos', active);
			b.classList.toggle('text-cream', active);
			b.classList.toggle('border-burdeos', active);
			b.classList.toggle('border-line', !active);
			b.classList.toggle('text-ink-soft', !active);
			b.classList.toggle('bg-paper', !active);
		}
	}

	for (const b of categoryButtons) {
		b.addEventListener('click', () => applyCategory(b.getAttribute('data-category-btn')!));
	}

	applyCategory(category);

	if (scrollTarget) {
		requestAnimationFrame(() => scrollTarget?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
	}

	const drinkTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-drink-tab]'));
	const drinkPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-drink-panel]'));

	const DRINK_TAB_BY_CATEGORY: Record<string, string> = {
		tintos: 'vinos',
		blancos: 'vinos',
		rosados: 'vinos',
		espumosos: 'vinos',
		industriales: 'bebidas',
		artesanas: 'bebidas',
		zumos: 'bebidas',
		kombuchas: 'bebidas',
		limonada: 'bebidas',
	};

	function applyDrinkTab(id: string) {
		for (const panel of drinkPanels) {
			const on = panel.getAttribute('data-drink-panel') === id;
			panel.hidden = !on;
			panel.toggleAttribute('inert', !on);
		}
		for (const t of drinkTabs) {
			const active = t.getAttribute('data-drink-tab') === id;
			t.setAttribute('aria-selected', String(active));
			t.classList.toggle('bg-burdeos', active);
			t.classList.toggle('text-cream', active);
			t.classList.toggle('border-burdeos', active);
			t.classList.toggle('border-line', !active);
			t.classList.toggle('text-ink-soft', !active);
			t.classList.toggle('bg-paper', !active);
		}
	}

	if (drinkTabs.length) {
		for (const t of drinkTabs) {
			t.addEventListener('click', () => {
				applyDrinkTab(t.getAttribute('data-drink-tab')!);
				const drinks = document.getElementById('bebidas');
				if (drinks) {
					const rect = drinks.getBoundingClientRect();
					if (!(rect.top < window.innerHeight && rect.bottom > 0)) {
						drinks.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				}
			});
		}
		const drinkAnchors = drinkPanels.map((p) => p.getAttribute('data-drink-panel'));
		const hashCategoryTab = DRINK_TAB_BY_CATEGORY[fromHash];
		let initialDrink = drinkAnchors[0] ?? '';
		if (drinkAnchors.includes(fromHash)) initialDrink = fromHash;
		else if (hashCategoryTab) initialDrink = hashCategoryTab;
		applyDrinkTab(initialDrink);
		if (hashCategoryTab) {
			requestAnimationFrame(() => document.getElementById(fromHash)?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
		}
	}
</script>