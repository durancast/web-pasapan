---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { formatPrice } from '../data/site';

const primeros = [
	'Ensalada de atún con pimientos del piquillo y aceitunas negras',
	'Crema de marisco a la Donostiarra con calamares y croutons',
	'Arroz salteado con verduritas estilo thai',
];
const segundos = [
	'Lubina a la parrilla con verduritas al wok',
	'Pechuga de pollo a la parrilla con ensalada',
	'Filetes de lomo de cerdo a la parrilla con mojo picón y patatas fritas',
];
const postres = [
	'Bola de helado de vainilla con tierra de brownie',
	'Tarta de queso casera con mermelada de frutos rojos',
	'Brownie de chocolate con mermelada de frutos rojos',
	'Crema de yogur con frutos del bosque',
	'Fruta preparada del día',
];
const combos = [
	'Quesadilla de pollo de corral al chilindrón',
	'Tacos de cochinita pibil con salsa sriracha y guacamole',
	'Hamburguesa completa 100% segoviana con salsa de Whisky DYC',
	'Lasaña de ternera con queso de oveja gratinado',
];

const menus = [
	{
		id: 'menu-del-dia',
		anchor: 'menu-del-dia',
		title: 'Menú del día',
		price: 14.95,
		includes: 'Dos platos a elegir entre primeros y/o segundos + bebida + pan + postre',
		groups: [
			{ label: 'Primeros', items: primeros },
			{ label: 'Segundos', items: segundos },
			{ label: 'Postres', items: postres },
		],
	},
	{
		id: 'plato-del-dia',
		anchor: 'plato-del-dia',
		title: 'Plato del día',
		price: 8.95,
		includes: 'Un plato a elegir entre primeros y segundos + bebida + pan + postre',
		groups: [
			{ label: 'Primeros', items: primeros },
			{ label: 'Segundos', items: segundos },
			{ label: 'Postres', items: postres },
		],
	},
	{
		id: 'combo-pasa-naaam',
		anchor: 'combo-pasa-naaam',
		title: 'Combo Pasa-Ñaaam',
		price: 14.95,
		includes: 'Un plato a elegir + bebida + postre',
		note: 'Opciones vegetarianas-veganas del Combo Pasa-Ñaaam disponibles',
		groups: [
			{ label: 'Principales', items: combos },
			{ label: 'Postres', items: postres },
		],
	},
];
---
<BaseLayout
	title="Menú del día · Restaurante Pasapán · Segovia"
	description="Menú del día (14,95€), plato del día (8,95€) y Combo Pasa-Ñaaam en Restaurante Pasapán, Segovia. De martes a viernes no festivos en horario de comidas."
>
	<PageHero
		title="Nuestros Menús de Diario"
		eyebrow="De martes a viernes no festivos en horario de comidas"
		description="Sugerencias de nuestra cocina para cada día, pensadas para comer bien sin perder el ritmo."
		image="/img/restaurant/platos.jpg"
	/>

	<nav aria-label="Menús del día" class="sticky top-[105px] z-40 border-b border-line bg-paper/90 backdrop-blur-md">
		<ul class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-4 py-3 text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase sm:px-6">
			{menus.map((m) => (
				<li>
					<a href={`#${m.anchor}`} class="shrink-0 whitespace-nowrap transition-colors hover:text-burdeos">{m.title}</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="mx-auto max-w-4xl space-y-16 px-4 py-16 sm:px-6">
		{menus.map((menu) => (
			<section id={menu.anchor} class="scroll-mt-40">
				<div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
					<h2 class="font-display text-3xl font-medium text-ink sm:text-4xl">{menu.title}</h2>
					<p class="font-display text-3xl font-semibold text-burdeos">{formatPrice(menu.price)}</p>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-ink-soft italic">{menu.includes}</p>
				{menu.note ? <p class="mt-2 inline-block rounded-full bg-olive/15 px-4 py-1 text-xs font-semibold tracking-widest text-olive uppercase">{menu.note}</p> : null}

				{menu.groups.map((group) => (
					<div class="mt-8">
						<h3 class="flex items-center gap-3 text-xs font-bold tracking-[0.22em] text-gold uppercase">
							<span aria-hidden="true">✦</span>
							{group.label}
						</h3>
						<ul class="mt-3 divide-y divide-line/70 rounded-2xl border border-line bg-cream">
							{group.items.map((item) => (
								<li class="px-5 py-3 text-sm leading-relaxed text-ink-soft">
									<span class="mr-2 text-burdeos" aria-hidden="true">•</span>
									{item}
								</li>
							))}
						</ul>
					</div>
				))}
			</section>
		))}
	</div>

	<CtaBanner />
</BaseLayout>