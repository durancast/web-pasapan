---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { NAV_I18N } from '../data/i18n';
import { formatPrice } from '../data/site';

const es = NAV_I18N.es;

const primeros = ['menu.item.p1', 'menu.item.p2', 'menu.item.p3'];
const segundos = ['menu.item.s1', 'menu.item.s2', 'menu.item.s3'];
const postres = ['menu.item.d1', 'menu.item.d2', 'menu.item.d3', 'menu.item.d4', 'menu.item.d5'];
const combos = ['menu.item.c1', 'menu.item.c2', 'menu.item.c3', 'menu.item.c4'];

const dailyCourses = () => [
	{ labelKey: 'menu.group.primero', items: primeros },
	{ labelKey: 'menu.group.segundo', items: segundos },
	{ labelKey: 'menu.group.postre', items: postres },
];

const menus = [
	{
		id: 'menu-del-dia',
		anchor: 'menu-del-dia',
		titleKey: 'menu.dia.title',
		price: 14.95,
		includesKey: 'menu.dia.includes',
		groups: dailyCourses(),
	},
	{
		id: 'plato-del-dia',
		anchor: 'plato-del-dia',
		titleKey: 'menu.plato.title',
		price: 8.95,
		includesKey: 'menu.plato.includes',
		groups: dailyCourses(),
	},
	{
		id: 'combo-pasa-naaam',
		anchor: 'combo-pasa-naaam',
		titleKey: 'menu.combo.title',
		price: 14.95,
		includesKey: 'menu.combo.includes',
		noteKey: 'menu.combo.note',
		groups: [
			{ labelKey: 'menu.group.principal', items: combos },
			{ labelKey: 'menu.group.postre', items: postres },
		],
	},
];
---
<BaseLayout
	title="Menú del día · Restaurante Pasapán · Segovia"
	description="Menú del día (14,95€), plato del día (8,95€) y Combo Pasa-Ñaaam en Restaurante Pasapán, Segovia. De martes a viernes no festivos en horario de comidas."
>
	<PageHero
		title="Nuestros Menús de Diario"
		titleI18n="page.menu.title"
		eyebrow="De martes a viernes no festivos en horario de comidas"
		eyebrowI18n="page.menu.eyebrow"
		description="Sugerencias de nuestra cocina para cada día, pensadas para comer bien sin perder el ritmo."
		descriptionI18n="page.menu.desc"
		image="/img/restaurant/platos.jpg"
	/>

	<nav aria-label="Menús del día" data-i18n-aria="menu.navAria" class="sticky z-40 border-b border-line bg-paper/90 backdrop-blur-md" style="top: var(--header-offset, 88px)">
		<ul class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-4 py-2 text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase sm:px-6 sm:py-3">
			{menus.map((m) => (
				<li>
					<a href={`#${m.anchor}`} data-i18n={m.titleKey} class="shrink-0 whitespace-nowrap transition-colors hover:text-burdeos">{es[m.titleKey]}</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="mx-auto max-w-4xl space-y-16 px-4 py-16 sm:px-6">
		{menus.map((menu) => (
			<section id={menu.anchor} class="scroll-mt-40">
				<div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
					<h2 data-i18n={menu.titleKey} class="font-display text-3xl font-medium text-ink sm:text-4xl">{es[menu.titleKey]}</h2>
					<p class="font-display text-3xl font-semibold text-burdeos">{formatPrice(menu.price)}</p>
				</div>
				<p data-i18n={menu.includesKey} class="mt-4 text-sm leading-relaxed text-ink-soft italic">{es[menu.includesKey]}</p>
				{menu.noteKey ? <p data-i18n={menu.noteKey} class="mt-2 inline-block rounded-full bg-olive/15 px-4 py-1 text-xs font-semibold tracking-widest text-olive uppercase">{es[menu.noteKey]}</p> : null}

				{menu.groups.map((group) => (
					<div class="mt-8">
						<h3 class="flex items-center gap-3 text-xs font-bold tracking-[0.22em] text-gold uppercase">
							<span aria-hidden="true">✦</span>
							<span data-i18n={group.labelKey}>{es[group.labelKey]}</span>
						</h3>
						<ul class="mt-3 divide-y divide-line/70 rounded-2xl border border-line bg-cream">
							{group.items.map((item) => (
								<li class="px-5 py-3 text-sm leading-relaxed text-ink-soft">
									<span class="mr-2 text-burdeos" aria-hidden="true">•</span>
									<span data-i18n={item}>{es[item]}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</section>
		))}
	</div>

	<CtaBanner />
</BaseLayout>
