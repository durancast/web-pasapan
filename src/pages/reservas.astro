---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RestooEmbed from '../components/RestooEmbed.astro';
import { site } from '../data/site';
---
<BaseLayout
	title="Reservas · Restaurante Pasapán · Segovia"
	description="Reserva tu mesa en el Restaurante Pasapán de Segovia online, por teléfono 921 70 10 06 o pasando por el local. Abierto de martes a domingo."
>
	<PageHero
		title="Reserva tu mesa"
		titleI18n="page.reservas.title"
		eyebrow="Reservas"
		eyebrowI18n="page.reservas.eyebrow"
		description="Garantiza tu mesa en el corazón de Segovia. Reserva online, por teléfono o directamente en el local."
		descriptionI18n="page.reservas.desc"
		image="/img/restaurant/logo-pared.jpg"
	/>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
			<aside class="space-y-6">
				<div class="rounded-2xl border border-line bg-cream p-6">
					<h2 data-i18n="reservas.hoursTitle" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">Horario de apertura</h2>
					<ul class="mt-4 space-y-2 text-sm text-ink-soft">
						<li>
							<p class="font-semibold text-ink" data-i18n="days">{site.hours[0].day}</p>
							{site.hours.map((h) => (
								<p>{h.label}</p>
							))}
						</li>
					</ul>
				</div>

				<div class="rounded-2xl border border-line bg-cream p-6">
					<h2 data-i18n="reservas.phoneTitle" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">Reservas por teléfono</h2>
					<p class="mt-4 text-sm leading-relaxed text-ink-soft">
						<span data-i18n="reservas.phoneText">¿Prefieres hablar con nosotros?</span>
						<a href={`tel:${site.phone.tel}`} class="mt-1 block font-semibold text-burdeos hover:underline">
							{site.phone.display}
						</a>
					</p>
				</div>

				<div class="rounded-2xl border border-line bg-cream p-6">
					<h2 data-i18n="reservas.whereTitle" class="text-xs font-semibold tracking-[0.18em] text-burdeos uppercase">¿Dónde estamos?</h2>
					<address class="mt-4 text-sm leading-relaxed text-ink-soft not-italic">
						{site.name}<br />
						{site.address.street}<br />
						{site.address.postalCode} {site.address.city}
					</address>
				</div>
			</aside>

			<div class="space-y-4">
				<h2 data-i18n="reservas.onlineTitle" class="font-display text-2xl font-medium text-ink">Reserva online con Restoo</h2>
				<p data-i18n="reservas.onlineText" class="text-sm leading-relaxed text-ink-soft">
					Selecciona fecha, hora y comensales. Recibirás la confirmación por email. Para grupos, llamadnos y lo organizamos con mucho gusto.
				</p>
				<RestooEmbed openLabel="¿No carga el sistema de reservas?" openLabelI18n="reservas.embedLabel" openText="Abrir el sistema de reservas en una nueva pestaña" openTextI18n="reservas.embedText" />
			</div>
		</div>
	</section>
</BaseLayout>